# ============================================================
#  FCI AI · 环境变量示例文件
#  用法：复制为 .env 后填入真实值。切勿把 .env 提交到仓库。
# ============================================================

# ---------- Flask / 会话 ----------
FLASK_APP=app.py
FLASK_ENV=development
# 生成方式：python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-32-byte-hex

# ---------- 翻译模型 API ----------
# 阿里云百炼（DashScope）控制台 → API-KEY 管理
QWEN_API_KEY=
# DeepSeek 开放平台 → API keys（可选）
DEEPSEEK_API_KEY=
# 通用/兼容端点使用的 key
API_KEY=
# MinerU PDF 解析服务（可选）
MINERU_API_KEY=

# ---------- 数据库 ----------
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ppt_translate_db
DB_USER=ppt_user
DB_PASSWORD=
DB_POOL_SIZE=20
DB_CONNECT_TIMEOUT=10
DB_USE_SSL=false
# 使用 SQLite 时可置 DB_TYPE=sqlite 并设置：
SQLITE_DB_PATH=instance/app.db

# ---------- 上传 / 存储 ----------
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=209715200
USER_STORAGE_QUOTA=1073741824
FILE_CLEANUP_DAYS=7
TEMP_FILE_CLEANUP_HOURS=24

# ---------- 任务队列 / 并发 ----------
MAX_CONCURRENT_TASKS=10
TASK_QUEUE_TIMEOUT=3600
TASK_QUEUE_RETRY_TIMES=3
THREAD_POOL_IO_WORKERS=8
THREAD_POOL_CPU_WORKERS=4

# ---------- LibreOffice（PPT 格式处理） ----------
# Linux 示例: /usr/bin/soffice
# Windows 示例: C:\Program Files\LibreOffice\program\soffice.exe
SOFFICE_PATH=
LIBREOFFICE_PYTHON=

# ---------- SSO（OAuth2 / OIDC） ----------
SSO_ENABLED=false
SSO_PROVIDER=oauth2
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_AUTHORIZATION_URL=
OAUTH2_TOKEN_URL=
OAUTH2_USERINFO_URL=
OAUTH2_REDIRECT_URI=http://localhost:5000/auth/sso/callback
OAUTH2_SCOPE=openid profile email

# ---------- 邮件（任务通知，可选） ----------
MAIL_SERVER=
MAIL_PORT=465
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# ---------- 日志 ----------
LOG_LEVEL=INFO
LOG_DIR=logs

# ---------- 监控（可选） ----------
ENABLE_MONITORING=false
SENTRY_DSN=
